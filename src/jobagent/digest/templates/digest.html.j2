<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{{ digest.subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f4f4f5;">
<tr><td align="center" style="padding:16px 8px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;background:#fff;border-radius:8px;">
<tr><td style="padding:12px 20px 20px;font:14px/1.4 -apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#18181b;">
<div style="font-size:20px;font-weight:700;padding-top:8px;">{{ digest.subject }}</div>
<div style="font-size:13px;color:#71717a;">Job digest &middot; {{ digest.today.strftime("%a %d %b %Y") }}</div>
{% for section in digest.sections %}
<div style="font-size:16px;font-weight:700;border-bottom:2px solid #e4e4e7;padding:20px 0 6px;">{{ section.name }} <span style="font-weight:400;color:#71717a;">({{ section.count }})</span></div>
{% if section.stars %}
<div style="font-size:12px;color:#71717a;padding-top:4px;">&#9733; company with a US transfer path</div>
{% endif %}
{% for line in section.full %}
<div style="padding:10px 0;border-bottom:1px solid #f4f4f5;">
<div style="font-weight:600;"><span style="display:inline-block;min-width:30px;padding:1px 4px;border-radius:5px;text-align:center;color:#fff;background:{{ badge_color(line.fit) }};">{{ line.score }}</span> {% if line.star %}<span style="color:#ca8a04;">&#9733;</span> {% endif %}{{ line.company }} &middot; {{ line.title }}</div>
<div style="font-size:13px;color:#52525b;padding-top:2px;">{{ line.location }} &middot; {{ line.yoe }} &middot; {{ days_text(line.days_posted) }}{% if line.rule %} &middot; <i>rule score</i>{% endif %}{% if line.duplicates %} &middot; +{{ line.duplicates }} identical posting{{ "s" if line.duplicates > 1 }}{% endif %}</div>
<div style="font-size:13px;padding-top:3px;">{{ line.reason }} <a href="{{ line.url }}" style="color:#2563eb;font-weight:600;text-decoration:none;">Apply&nbsp;&rarr;</a></div>
</div>
{% endfor %}
{% if section.compact %}
<div style="font-size:13px;font-weight:600;color:#52525b;padding:12px 0 4px;">More Medium matches ({{ section.compact|length }})</div>
<div style="font-size:13px;">
{% for line in section.compact %}
<b style="color:{{ badge_color(line.fit) }};">{{ line.score }}</b> {% if line.star %}&#9733; {% endif %}{{ line.company }} &middot; {{ line.title }} &middot; {{ line.location }}{% if line.rule %} &middot; <i>rule score</i>{% endif %} &middot; <a href="{{ line.url }}" style="color:#2563eb;">Apply</a><br>
{% endfor %}
</div>
{% endif %}
{% endfor %}
<div style="font-size:12px;color:#a1a1aa;padding-top:20px;">Scores: 75+ High, 50&ndash;74 Medium, ranked against your CV profile. Links come from the job boards. Jobs in this email are not sent again.</div>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
